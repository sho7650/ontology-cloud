/**
 * ontology-mcp — Cloudflare Workers 設定
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ontology-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // ontology.yaml と migrations/*.sql を文字列として同梱する
  "rules": [{ "type": "Text", "globs": ["**/*.yaml", "**/*.sql"], "fallthrough": true }],
  "vars": {
    // 管理画面とリセットを許可する Google アカウント
    "OWNER_EMAIL": "tak7650@gmail.com"
  },
  // id を書かないことで、初回デプロイ時に KV と D1 が自動作成される (wrangler 4.45+ の自動プロビジョニング。
  // ダッシュボードの GitHub 連携からのデプロイでも有効)。手動で作った既存リソースを使う場合は id / database_id を追記する。
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "d1_databases": [{ "binding": "DB", "database_name": "ontology", "migrations_dir": "migrations" }],
  "observability": { "enabled": true },
  "dev": { "port": 8788 }
}
