/**
 * ontology-mcp — Cloudflare Workers 設定
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ontology-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // ontology.yaml を文字列として同梱する
  "rules": [{ "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }],
  "vars": {
    // 管理画面とリセットを許可する Google アカウント
    "OWNER_EMAIL": "tak7650@gmail.com"
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "<wrangler kv namespace create OAUTH_KV の出力に置き換える>" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ontology",
      "database_id": "<wrangler d1 create ontology の出力に置き換える>",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "dev": { "port": 8788 }
}
